# Server
PORT=3001

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o

# Environment
NODE_ENV=development

# Auth (auth.service.js) — signs the session cookie's JWT. Generate a real
# random value for anything beyond local dev, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-value

# DEV-ONLY: allow analyzing localhost/private targets (e.g. fixture-site). Never enable in production.
ALLOW_LOCAL_TARGETS=false

# Custom Python validation engine (python-validation/runner.py)
# A full run (all checks, multiple browsers x viewports) can take ~30s+ on a
# small site and 90s+ on a heavy real one (WebKit launches were the slowest
# observed). If a run still times out, functional/crossBrowser fall back to
# {status:"not-run"} instead of a misleading score (see scoringNode.js).
PYTHON_EXECUTABLE=python3
PYTHON_VALIDATION_TIMEOUT_MS=150000
