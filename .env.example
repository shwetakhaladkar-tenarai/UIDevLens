# Server
PORT=3001

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o

# Environment
NODE_ENV=development

# DEV-ONLY: allow analyzing localhost/private targets (e.g. demo-site). Never enable in production.
ALLOW_LOCAL_TARGETS=false

# Custom Python validation engine (python-validation/runner.py)
PYTHON_EXECUTABLE=python3
PYTHON_VALIDATION_TIMEOUT_MS=30000
