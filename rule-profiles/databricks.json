{
  "id": "databricks-v1",
  "targetType": "databricks",
  "description": "Databricks notebooks/dashboards — internal analytics tooling typically accessed only through Chromium-based browsers on desktop in enterprise environments. UI consistency is skipped (Databricks-owned UI); responsive and cross-browser checks are skipped as not applicable to this usage pattern.",

  "enabledChecks": {
    "functional": true,
    "accessibility": true,
    "responsive": false,
    "crossBrowser": false,
    "performance": true,
    "uiConsistency": false
  },

  "browsers": ["chromium"],

  "viewports": {
    "desktop": { "width": 1440, "height": 900 },
    "tablet":  { "width": 1024, "height": 768 },
    "mobile":  { "width": 390,  "height": 844 }
  },

  "accessibility": { "standard": "WCAG", "level": "A" },

  "performance": {
    "enabled": true,
    "loadTest": {
      "enabled": false,
      "approved": false,
      "users": [10, 100, 500, 1000],
      "durationSeconds": 60,
      "thresholds": { "p95ResponseTimeMs": 2000, "errorRatePercent": 1 }
    }
  }
}
